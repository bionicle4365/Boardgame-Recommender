# ==============================================================================
# Local Development Environment Variables (.env.local)
# ==============================================================================
# Copy this file to `site_ui/.env.local` (which is gitignored) and fill in your
# actual backend values:
#
#   cp site_ui/.env.local.example site_ui/.env.local
#
# Then run the helper script to generate `site_ui/_config.local.yml`:
#   python scripts/gen_local_config.py
#
# And serve Jekyll:
#   bundle exec jekyll serve --config _config.yml,_config.local.yml
# ==============================================================================

# AWS API Gateway HTTP/REST Endpoint URL
# Example: https://abc123xyz.execute-api.us-east-1.amazonaws.com
API_URL=https://YOUR_API_GATEWAY_URL.execute-api.us-east-1.amazonaws.com

# AWS Cognito Authentication Settings
COGNITO_REGION=us-east-1
COGNITO_CLIENT_ID=YOUR_COGNITO_APP_CLIENT_ID
COGNITO_USER_POOL_ID=us-east-1_YOUR_POOL_ID

# Optional Local URL & Baseurl Overrides
BASEURL=
URL=http://localhost:4000
